# ---------- Database ----------
# MongoDB Atlas connection string. Create a database user with readWrite on this
# database only, and allow 0.0.0.0/0 in Network Access (Vercel IPs are dynamic).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="prohealth"

# ---------- Email triggers ----------
# Any SMTP account works: Office 365, Google Workspace, Amazon SES, Brevo.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="careplan-noreply@hclhealthcare.in"
SMTP_PASS="app-password-or-smtp-key"
MAIL_FROM="ProHealth Programs <careplan-noreply@hclhealthcare.in>"

# Who gets notified. Comma separated. NOTIFY_EMAILS always receives everything.
NOTIFY_EMAILS="careplan@hclhealthcare.in,marketing.lead@hclhealthcare.in"
NOTIFY_CC=""
# Optional per program routing, added on top of NOTIFY_EMAILS.
NOTIFY_EMAILS_PLUS=""
NOTIFY_EMAILS_DIET=""
NOTIFY_EMAILS_LAB=""

# Send a confirmation mail to the person who registered.
SEND_USER_ACK="true"
# Also email the team when a brochure is downloaded. Off by default to avoid noise.
NOTIFY_ON_DOWNLOAD="false"

# ---------- Admin ----------
# Long random string. Used for /admin and the CSV export.
ADMIN_TOKEN="change-me-to-a-long-random-string"
# Salt for hashing visitor IPs. Any random string, keep it stable.
IP_HASH_SALT="change-me-too"

# ---------- Embedding ----------
# Origins allowed to iframe this microsite, space separated.
ALLOWED_FRAME_ANCESTORS="'self' https://*.hclhealthcare.in"
